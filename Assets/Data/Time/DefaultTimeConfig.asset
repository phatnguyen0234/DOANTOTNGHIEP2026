    bonusGoldReward: 1000
  - eventId: hung_kings
    holidayTitle: "Gi\u1ED7 T\u1ED5 H\xF9ng V\u01B0\u01A1ng (10/3 \xC2m l\u1ECBch)"
    calendarType: 1
    day: 10
    month: 3
    description: "Ng\xE0y l\u1EC5 h\u01B0\u1EDBng v\u1EC1 c\u1ED9i ngu\u1ED3n d\xE2n
      t\u1ED9c. C\u1EEDa h\xE0ng g\u1EEDi t\u1EB7ng ph\u1EA7n qu\xE0 tri \xE2n cho
      n\xF4ng tr\u1EA1i!"
    bonusGoldReward: 500
  - eventId: reunification_day
    holidayTitle: "Ng\xE0y Gi\u1EA3i Ph\xF3ng Mi\u1EC1n Nam (30/4)"
    calendarType: 0
    day: 30
    month: 4
    description: "K\u1EF7 ni\u1EC7m ng\xE0y th\u1ED1ng nh\u1EA5t \u0111\u1EA5t n\u01B0\u1EDBc
      30/04. Ch\xFAc b\u1EA1n m\u1ED9t ng\xE0y l\xE0m vi\u1EC7c th\u1EADt nhi\u1EC1u
      ni\u1EC1m vui!"
    bonusGoldReward: 500
  - eventId: labor_day
    holidayTitle: "Ng\xE0y Qu\u1ED1c T\u1EBF Lao \u0110\u1ED9ng (1/5)"
    calendarType: 0
    day: 1
    month: 5
    description: "T\xF4n vinh s\u1EE9c lao \u0111\u1ED9ng! Th\xE0nh qu\u1EA3 ch\u0103m
