  - eventId: vietnamese_women_day
    holidayTitle: "Ng\xE0y Ph\u1EE5 N\u1EEF Vi\u1EC7t Nam (20/10)"
    calendarType: 0
    day: 20
    month: 10
    description: "Ch\xFAc m\u1EEBng ng\xE0y Ph\u1EE5 n\u1EEF Vi\u1EC7t Nam 20/10!
