    bonusGoldReward: 800
  - eventId: mid_autumn
    holidayTitle: "T\u1EBFt Trung Thu (15/8 \xC2m l\u1ECBch)"
    calendarType: 1
    day: 15
    month: 8
    description: "\u0110\xEAm h\u1ED9i tr\u0103ng r\u1EB1m! D\xE2n l\xE0ng g\u1EEDi
