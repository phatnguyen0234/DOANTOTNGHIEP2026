      tr\xE2n tr\u1ECDng."
    bonusGoldReward: 400
  - eventId: national_day
    holidayTitle: "Qu\u1ED1c Kh\xE1nh Vi\u1EC7t Nam (2/9)"
    calendarType: 0
    day: 2
    month: 9
    description: "Ch\xE0o m\u1EEBng ng\xE0y Qu\u1ED1c Kh\xE1nh 02/09! C\u1EA3 th\u1ECB
